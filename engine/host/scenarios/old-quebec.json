{
  "name": "Reach the observation point, then the pick-up",
  "scene": "../scenes/old-quebec.json",
  "start": { "x": 0, "z": -60, "heading": 0 },
  "setup": [
    { "op": "say", "text": "Move north to the observation point", "seconds": 8 },
    { "op": "mark", "id": "obs", "kind": "objective", "label": "Observation point", "x": 0, "z": -68, "radius": 2.5 },
    { "op": "spawn", "id": "sentry-1", "kind": "sentry", "x": 40, "z": -100, "heading": 270, "route": [[40, -100], [40, -115], [55, -115]] },
    { "op": "spawn", "id": "sentry-2", "kind": "sentry", "x": -20, "z": -120, "heading": 90, "route": [[-20, -120], [-20, -135], [-5, -135]] },
    { "op": "spawn", "id": "quad-1", "kind": "quadcopter", "x": 60, "z": -120, "route": [[60, -120], [-40, -120], [-40, -40], [60, -40]] }
  ],
  "rules": [
    { "when": { "event": "interact", "id": "obs", "action": "reached" },
      "do": [ { "op": "unmark", "id": "obs" }, { "op": "say", "text": "Observation point reached. Go to the pick-up." },
              { "op": "mark", "id": "pickup", "kind": "extraction", "label": "Pick-up", "x": 0, "z": -74, "radius": 2.5 } ] },
    { "when": { "event": "interact", "id": "pickup", "action": "reached" },
      "do": [ { "op": "say", "text": "Mission complete" }, { "op": "end", "result": "complete" } ] }
  ]
}
